{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "Tag"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "tags"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "mappedBy": "tags"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "text"
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "twitterTitle": {
      "type": "string"
    },
    "twitterDescription": {
      "type": "text"
    },
    "robots": {
      "type": "enumeration",
      "enum": [
        "index_follow",
        "noindex_follow",
        "index_nofollow",
        "noindex_nofollow"
      ]
    },
    "schemaType": {
      "type": "enumeration",
      "enum": [
        "Article",
        "BlogPosting",
        "NewsArticle",
        "CreativeWork",
        "CollectionPage",
        "ProfilePage",
        "Report",
        "DefinedTerm"
      ]
    },
    "focusKeyword": {
      "type": "string"
    },
    "secondaryKeywords": {
      "type": "json"
    },
    "aiSummary": {
      "type": "text"
    },
    "answerSnippet": {
      "type": "text"
    },
    "llmSummary": {
      "type": "text"
    },
    "entityMentions": {
      "type": "json"
    },
    "geoTopics": {
      "type": "json"
    },
    "geoQuestions": {
      "type": "json"
    },
    "structuredDataOverride": {
      "type": "json"
    }
  }
}
