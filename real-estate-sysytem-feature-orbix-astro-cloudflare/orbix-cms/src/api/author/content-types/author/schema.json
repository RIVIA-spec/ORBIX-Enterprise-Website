{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "Author"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "arabicSlug": {
      "type": "string"
    },
    "preferredSlugLanguage": {
      "type": "enumeration",
      "enum": [
        "en",
        "ar"
      ],
      "default": "en"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "bio": {
      "type": "text"
    },
    "role": {
      "type": "string"
    },
    "expertise": {
      "type": "json"
    },
    "socialLinks": {
      "type": "json"
    },
    "authorType": {
      "type": "enumeration",
      "enum": [
        "editor",
        "contributor",
        "student",
        "founder",
        "engineer",
        "creator"
      ]
    },
    "universityOrCompany": {
      "type": "string"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "author"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "text"
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "twitterTitle": {
      "type": "string"
    },
    "twitterDescription": {
      "type": "text"
    },
    "robots": {
      "type": "enumeration",
      "enum": [
        "index_follow",
        "noindex_follow",
        "index_nofollow",
        "noindex_nofollow"
      ]
    },
    "schemaType": {
      "type": "enumeration",
      "enum": [
        "Article",
        "BlogPosting",
        "NewsArticle",
        "CreativeWork",
        "CollectionPage",
        "ProfilePage",
        "Report",
        "DefinedTerm"
      ]
    },
    "focusKeyword": {
      "type": "string"
    },
    "secondaryKeywords": {
      "type": "json"
    },
    "aiSummary": {
      "type": "text"
    },
    "answerSnippet": {
      "type": "text"
    },
    "llmSummary": {
      "type": "text"
    },
    "entityMentions": {
      "type": "json"
    },
    "geoTopics": {
      "type": "json"
    },
    "geoQuestions": {
      "type": "json"
    },
    "structuredDataOverride": {
      "type": "json"
    }
  }
}
