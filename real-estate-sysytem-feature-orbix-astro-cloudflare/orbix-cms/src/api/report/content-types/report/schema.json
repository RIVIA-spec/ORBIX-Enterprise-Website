{
  "kind": "collectionType",
  "collectionName": "reports",
  "info": {
    "singularName": "report",
    "pluralName": "reports",
    "displayName": "Special File"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "arabicSlug": {
      "type": "string"
    },
    "preferredSlugLanguage": {
      "type": "enumeration",
      "enum": [
        "en",
        "ar"
      ],
      "default": "en"
    },
    "excerpt": {
      "type": "text"
    },
    "city": {
      "type": "string"
    },
    "market": {
      "type": "string"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "body": {
      "type": "json"
    },
    "dataPoints": {
      "type": "json"
    },
    "keyTakeaways": {
      "type": "json"
    },
    "relatedArticleSlugs": {
      "type": "json"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "text"
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "twitterTitle": {
      "type": "string"
    },
    "twitterDescription": {
      "type": "text"
    },
    "robots": {
      "type": "enumeration",
      "enum": [
        "index_follow",
        "noindex_follow",
        "index_nofollow",
        "noindex_nofollow"
      ]
    },
    "schemaType": {
      "type": "enumeration",
      "enum": [
        "Article",
        "BlogPosting",
        "NewsArticle",
        "CreativeWork",
        "CollectionPage",
        "ProfilePage",
        "Report",
        "DefinedTerm"
      ]
    },
    "focusKeyword": {
      "type": "string"
    },
    "secondaryKeywords": {
      "type": "json"
    },
    "aiSummary": {
      "type": "text"
    },
    "answerSnippet": {
      "type": "text"
    },
    "llmSummary": {
      "type": "text"
    },
    "entityMentions": {
      "type": "json"
    },
    "geoTopics": {
      "type": "json"
    },
    "geoQuestions": {
      "type": "json"
    },
    "structuredDataOverride": {
      "type": "json"
    }
  }
}
