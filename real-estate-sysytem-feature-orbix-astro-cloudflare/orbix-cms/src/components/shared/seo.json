{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "description": "Search and social metadata"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "required": true,
      "maxLength": 60
    },
    "metaDescription": {
      "type": "text",
      "required": true,
      "maxLength": 160
    },
    "canonicalPath": {
      "type": "string"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "noIndex": {
      "type": "boolean",
      "default": false
    },
    "noFollow": {
      "type": "boolean",
      "default": false
    },
    "shareImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "openGraphTitle": {
      "type": "string",
      "maxLength": 70
    },
    "openGraphDescription": {
      "type": "text",
      "maxLength": 200
    },
    "twitterTitle": {
      "type": "string",
      "maxLength": 70
    },
    "twitterDescription": {
      "type": "text",
      "maxLength": 200
    },
    "focusKeyword": {
      "type": "string"
    },
    "secondaryKeywords": {
      "type": "json"
    },
    "aiSummary": {
      "type": "text"
    },
    "answerSnippet": {
      "type": "text"
    },
    "llmSummary": {
      "type": "text"
    },
    "entityMentions": {
      "type": "json"
    },
    "geoTopics": {
      "type": "json"
    },
    "geoQuestions": {
      "type": "json"
    }
  }
}
