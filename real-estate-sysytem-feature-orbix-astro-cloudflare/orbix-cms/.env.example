HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Local development stays on SQLite by default when DATABASE_CLIENT is omitted or set to sqlite.
# Production Postgres:
# 1. Railway preferred: set DATABASE_CLIENT=postgres and DATABASE_URL
# 2. Manual fallback: set DATABASE_CLIENT=postgres and the host/port/name/user/password fields below
DATABASE_CLIENT=sqlite

# Railway / URL-based Postgres
DATABASE_URL=postgresql://user:password@host:5432/database

# Manual Postgres connection fields
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# Ollama AI summary generation
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_INTERNAL_SECRET=change-this-secret
