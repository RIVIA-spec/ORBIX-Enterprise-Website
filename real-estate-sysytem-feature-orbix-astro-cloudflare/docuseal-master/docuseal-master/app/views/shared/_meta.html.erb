<% if Docuseal.demo? || (request.path != '/' && !devise_controller?) %>
  <meta name="robots" content="noindex">
<% end %>
<% title = content_for(:html_title) || (signed_in? ? Docuseal.product_name : "#{Docuseal.product_name} | #{Docuseal.public_description}") %>
<% description = content_for(:html_description) || Docuseal.public_description %>
<meta name="description" content="<%= description %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:type" content="website">
<meta property="og:url" content="<%= root_url %>">
<meta property="og:site_name" content="<%= Docuseal.product_name %>">
<% if content_for(:disable_image_preview) %>
  <meta property="og:image" content="">
  <meta name="twitter:image" content="">
<% else %>
  <meta property="og:image" content="<%= content_for(:preview_image_url).presence || "#{root_url}orbix.png" %>">
  <meta property="og:image:width" content="800">
  <meta property="og:image:height" content="800">
  <meta name="twitter:image" content="<%= content_for(:preview_image_url).presence || "#{root_url}orbix.png" %>">
<% end %>
<meta name="twitter:card" content="summary">
<meta name="twitter:creator" content="">
<meta name="twitter:site" content="">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= description %>">
<link rel="apple-touch-icon" sizes="180x180" href="/orbix.png">
<link rel="icon" type="image/png" sizes="32x32" href="/orbix.png">
<link rel="icon" type="image/png" sizes="96x96" href="/orbix.png">
<link rel="icon" type="image/png" sizes="16x16" href="/orbix.png">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="theme-color" content="#f6f8fb">
