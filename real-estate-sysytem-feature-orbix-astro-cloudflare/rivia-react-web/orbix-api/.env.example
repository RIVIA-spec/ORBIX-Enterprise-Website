APP_ENV=local
NODE_ENV=development
PORT=4000
DATA_BACKEND=memory
CORS_ORIGINS=http://localhost:5173
FIREBASE_TARGET=emulator
FIREBASE_PROJECT_ID=orbix-local-dev
FIREBASE_CREDENTIAL_SOURCE=adc
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
ALLOW_REAL_FIREBASE=false
SWAGGER_ENABLED=true

# Railway Development only:
# FIREBASE_DEVELOPMENT_PROJECT_ID=replace-with-development-project-id
# FIREBASE_CREDENTIAL_SOURCE=base64
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=replace-with-base64-encoded-json
