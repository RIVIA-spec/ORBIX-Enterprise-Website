{
  "name": "orbix-api",
  "version": "0.1.0",
  "private": true,
  "description": "Orbix NestJS Modular Monolith API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "emulator:start": "java -jar %USERPROFILE%\\.cache\\firebase\\emulators\\cloud-firestore-emulator-v1.21.0.jar --host 127.0.0.1 --port 8080 --project_id orbix-local-dev --single_project_mode true --single_project_mode_error true --rules firestore.rules",
    "seed:emulator": "cross-env APP_ENV=local FIREBASE_TARGET=emulator ALLOW_REAL_FIREBASE=false FIREBASE_PROJECT_ID=orbix-local-dev FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed-emulator.js",
    "test:integration": "node scripts/run-firestore-integration.js",
    "test:all": "npm run test && npm run test:integration",
    "check:firebase:development": "node scripts/assert-development-target.js",
    "deploy:firestore:development": "node scripts/assert-development-target.js && node scripts/deploy-firestore-development.js",
    "smoke:firestore:development": "node scripts/smoke-test-firestore-development.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "firebase-tools": "^15.27.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
