---
import CmsPage from '~/components/orbix/CmsPage.astro';
import { getCollection } from '~/lib/strapi/client';
import type { CmsPage as CmsPageData } from '~/lib/strapi/types';

const articles = await getCollection<CmsPageData>('articles', false);
---

<CmsPage pathname="/articles" fallbackAllowed={false} />

<section
  class="border-t border-white/10 bg-[var(--orbix-dark)] px-4 py-14 text-white sm:px-6 md:py-20"
  aria-labelledby="articles-list-title"
>
  <div class="mx-auto max-w-7xl">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--orbix-blue-light)]">Orbix Editorial</p>
    <h2 id="articles-list-title" class="mt-4 max-w-4xl text-3xl font-semibold leading-tight sm:text-4xl">
      مقالات Orbix
    </h2>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        articles.map((article) => (
          <article class="rounded-lg border border-white/10 bg-white/[0.04] p-6" data-article-card>
            <p class="font-mono text-xs text-[var(--orbix-blue-light)]">{article.articleType || 'article'}</p>
            <h3 class="mt-3 text-2xl font-semibold text-white">
              <a class="hover:text-[var(--orbix-blue-light)]" href={`/articles/${article.slug}`}>
                {article.title}
              </a>
            </h3>
            {article.summary && <p class="mt-3 leading-7 text-white/70">{article.summary}</p>}
          </article>
        ))
      }
    </div>
  </div>
</section>
