---
import { Icon } from 'astro-icon/components';
import OrbixLogo from '~/components/orbix/OrbixLogo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';
import type { BrandSettings, MenuLink } from '~/lib/strapi/types';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

export interface Props {
  brand?: BrandSettings;
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
  logoVariant?: 'full' | 'mark';
}

const {
  id = 'header',
  brand,
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = true,
  showRssFeed = true,
  position = 'center',
  logoVariant = 'full',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const hasNavigation = links.length > 0;
---

<aw-header transition:persist="header">
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-slate-200/80 bg-white/90 text-[var(--orbix-navy)] backdrop-blur-xl transition-colors dark:border-white/10 dark:bg-[var(--orbix-dark)]/90 dark:text-white',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0"></div>
    <div
      class:list={[
        'relative py-3 px-3 md:px-6 mx-auto w-full text-[var(--orbix-navy)] dark:text-white',
        {
          'md:flex md:justify-between': position !== 'center',
        },
        {
          'md:grid md:grid-cols-3 md:items-center': position === 'center',
        },
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
        <a class="flex items-center" href={getHomePermalink()}>
          <OrbixLogo brand={brand} variant={logoVariant === 'mark' ? 'mark' : isDark ? 'light' : 'dark'} />
        </a>
        <div class="flex items-center md:hidden">
          {hasNavigation && <ToggleMenu />}
        </div>
      </div>
      <nav
        class="items-center w-full md:w-auto hidden md:flex md:mx-5 text-[var(--orbix-navy)] dark:text-white overflow-y-auto overflow-x-hidden md:overflow-visible md:justify-self-center"
        aria-label="Main navigation"
      >
        <ul
          class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium md:justify-center"
        >
          {
            links.map(({ text, href, links, ariaLabel, icon, openInNewTab }, index) => (
              <li class={links?.length ? 'dropdown' : ''}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class="hover:text-[var(--orbix-blue)] px-3 py-3 flex items-center whitespace-nowrap"
                      aria-label={ariaLabel || text}
                      aria-expanded="false"
                      aria-controls={`${id}-dropdown-${index}`}
                    >
                      {icon && <Icon name={icon} class="h-4 w-4 me-2" />}
                      {text}{' '}
                      <Icon
                        name="tabler:chevron-down"
                        class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline"
                      />
                    </button>
                    <ul
                      id={`${id}-dropdown-${index}`}
                      class="dropdown-menu overflow-hidden rounded-lg border border-slate-200 bg-white/95 py-2 shadow-2xl backdrop-blur-xl md:absolute md:hidden md:min-w-[260px] dark:border-white/10 dark:bg-[var(--orbix-surface)]/95"
                    >
                      {links.map(
                        ({ text: text2, href: href2, ariaLabel: ariaLabel2, icon: icon2, openInNewTab: newTab2 }) => (
                          <li>
                            <a
                              class:list={[
                                'block whitespace-nowrap px-5 py-3 text-sm text-[var(--orbix-navy)] transition hover:bg-blue-50 hover:text-[var(--orbix-blue)] dark:text-white/85 dark:hover:bg-white/10 dark:hover:text-[var(--orbix-blue-light)]',
                                { 'aw-link-active': href2 === currentPath },
                              ]}
                              href={href2 || '#'}
                              aria-label={ariaLabel2}
                              target={newTab2 ? '_blank' : undefined}
                              rel={newTab2 ? 'noopener noreferrer' : undefined}
                            >
                              {icon2 && <Icon name={icon2} class="inline h-4 w-4 me-2" />}
                              {text2}
                            </a>
                          </li>
                        )
                      )}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'hover:text-[var(--orbix-blue)] px-3 py-3 flex items-center whitespace-nowrap',
                      { 'aw-link-active': href === currentPath },
                    ]}
                    href={href || '#'}
                    aria-label={ariaLabel}
                    target={openInNewTab ? '_blank' : undefined}
                    rel={openInNewTab ? 'noopener noreferrer' : undefined}
                  >
                    {icon && <Icon name={icon} class="h-4 w-4 me-2" />}
                    {text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div
        class:list={[
          { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
          hasNavigation ? 'hidden md:flex' : 'flex',
          'md:self-center items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 md:justify-self-end',
        ]}
      >
        <div class="items-center flex justify-between w-full md:w-auto">
          <div class="flex">
            {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}
            {
              showRssFeed && (
                <a
                  class="inline-flex items-center rounded-lg p-2.5 text-sm text-[var(--orbix-navy)]/75 transition hover:bg-blue-50 hover:text-[var(--orbix-blue)] focus:outline-none focus:ring-4 focus:ring-[var(--orbix-blue)]/20 dark:text-white/80 dark:hover:bg-white/10 dark:hover:text-white"
                  aria-label="RSS Feed"
                  href={getAsset('/rss.xml')}
                >
                  <Icon name="tabler:rss" class="w-5 h-5" />
                </a>
              )
            }
          </div>
          {
            actions?.length ? (
              <span class="ml-4 rtl:ml-0 rtl:mr-4">
                {actions.map((btnProps) => (
                  <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto" />
                ))}
              </span>
            ) : (
              ''
            )
          }
        </div>
      </div>
    </div>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }

  @media (min-width: 768px) {
    :global(.dropdown.is-open > .dropdown-menu) {
      display: block;
    }
  }

  @media (max-width: 767px) {
    :global(.dropdown > button[aria-expanded='false'] + .dropdown-menu) {
      display: none;
    }
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('#header nav');
      const lastChild = this.querySelector<HTMLElement>('#header > div > div:last-child');
      const dropdowns = Array.from(this.querySelectorAll<HTMLElement>('.dropdown'));

      const setDropdownOpen = (dropdown: HTMLElement, open: boolean) => {
        dropdown.classList.toggle('is-open', open);
        dropdown.querySelector<HTMLButtonElement>(':scope > button')?.setAttribute('aria-expanded', String(open));
      };

      const closeDropdowns = (except?: HTMLElement) => {
        dropdowns.forEach((dropdown) => {
          if (dropdown !== except) setDropdownOpen(dropdown, false);
        });
      };

      // The header persists across view transitions (transition:persist), so
      // the server-rendered `aw-link-active` class would go stale. Re-compute it
      // on every navigation (astro:page-load fires on load and after each swap).
      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);

      const closeMenu = () => {
        closeDropdowns();
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('h-screen', 'expanded', 'bg-page');
        nav?.classList.add('hidden');
        lastChild?.classList.add('hidden');
      };

      dropdowns.forEach((dropdown) => {
        const button = dropdown.querySelector<HTMLButtonElement>(':scope > button');
        if (!button) return;

        button.addEventListener('click', () => {
          const shouldOpen = button.getAttribute('aria-expanded') !== 'true';
          closeDropdowns(dropdown);
          setDropdownOpen(dropdown, shouldOpen);
        });
        dropdown.addEventListener('mouseenter', () => {
          if (window.matchMedia('(min-width: 768px)').matches) setDropdownOpen(dropdown, true);
        });
        dropdown.addEventListener('mouseleave', () => {
          if (window.matchMedia('(min-width: 768px)').matches) setDropdownOpen(dropdown, false);
        });
        dropdown.addEventListener('focusin', () => setDropdownOpen(dropdown, true));
        dropdown.addEventListener('focusout', (event) => {
          if (!dropdown.contains(event.relatedTarget as Node | null)) setDropdownOpen(dropdown, false);
        });
        dropdown.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            setDropdownOpen(dropdown, false);
            button.focus();
          }
        });
      });

      // Mobile menu toggle.
      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('h-screen');
        header?.classList.toggle('expanded');
        header?.classList.toggle('bg-page');
        nav?.classList.toggle('hidden');
        lastChild?.classList.toggle('hidden');
      });

      // Close the mobile menu when a nav link is clicked.
      nav?.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const link = target.closest('a');

        if (link) {
          closeDropdowns();
          closeMenu();
        }
      });

      // Desktop dropdowns open on hover/`:focus-within`. When a dropdown link is
      // clicked it keeps focus, and because the header uses `transition:persist`
      // the dropdown would stay open after the client-side navigation. Blur the
      // link on click so it closes right away (the `astro:page-load` handler is
      // the safety net if focus is restored during the swap).
      nav?.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest<HTMLElement>('.dropdown-menu a');
        if (link) link.blur();
      });

      // Close it when leaving the mobile breakpoint.
      this.mql = window.matchMedia('(max-width: 767px)');
      this.onMqlChange = () => closeMenu();
      this.mql.addEventListener('change', this.onMqlChange);

      // Sticky header: toggle the `scroll` class past a small threshold.
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      document.removeEventListener('astro:page-load', this.onPageLoad);
    }

    // With `transition:persist` the header (and its focus) survives client-side
    // navigations, so a clicked dropdown link keeps `:focus-within` and its menu
    // would stay open on the next page. Drop the focus so the CSS closes it.
    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        a.classList.toggle('aw-link-active', norm(new URL(a.href).pathname) === current);
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
